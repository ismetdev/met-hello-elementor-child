# Normalise line endings in the repository to LF.
* text=auto

*.php text
*.css text
*.js  text
*.md  text
*.txt text
*.yml text

*.png binary
*.jpg binary
*.mo  binary

# Development files. Not part of a theme install.
# Keep this list in step with the exclude list in .github/workflows/release.yml,
# which is what actually builds the published zip. See DECISIONS D21.
/.editorconfig   export-ignore
/.gitattributes  export-ignore
/.github         export-ignore
/.gitignore      export-ignore
/composer.json   export-ignore
/composer.lock   export-ignore
/phpcs.xml.dist  export-ignore
/DOCS            export-ignore
/PLAN            export-ignore
