; Matches the WordPress Coding Standards. See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.{css,scss,js}]
indent_style = space
indent_size = 2

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[libs/**]
; Bundled third-party code. Leave it exactly as shipped.
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
