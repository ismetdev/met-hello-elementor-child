<?xml version="1.0"?>
<ruleset name="Met Hello Elementor Child">
	<description>WordPress Coding Standards for this theme.</description>

	<file>.</file>

	<!-- Third-party and generated code is not ours to lint. -->
	<exclude-pattern>/libs/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.0"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Git checks out CRLF on Windows; .gitattributes normalises line endings in
	     the repository itself, so this sniff would fail permanently on both dev
	     machines without fixing anything real. -->
	<rule ref="Generic.Files.LineEndings">
		<exclude-pattern>*</exclude-pattern>
	</rule>

	<!-- Every string must use the theme text domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="met-hello-child"/>
			</property>
		</properties>
	</rule>

	<!-- Everything global must carry a theme prefix. "met_" covers the local
	     template variables (met_card_link and similar); met_hello_child_ /
	     MET_HELLO_CHILD_ cover functions and constants. WPCS requires prefixes
	     of at least 4 characters, so the plain 3-letter "met" is not registered
	     on its own. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="met_"/>
				<element value="met_hello_child"/>
				<element value="MET_HELLO_CHILD"/>
			</property>
		</properties>
	</rule>
</ruleset>
